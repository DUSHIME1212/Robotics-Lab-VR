            uniform double mjc:forceRange:min = -150
            custom rel mjc:target
            append rel mjc:target = </X30/Physics/FR_Knee_joint>
        }

        def MjcActuator "HL_HipX_joint_actuator"
        {
            uniform double mjc:forceRange:max = 84
            uniform double mjc:forceRange:min = -84
            custom rel mjc:target
            append rel mjc:target = </X30/Physics/HL_HipX_joint>
        }

        def MjcActuator "HL_HipY_joint_actuator"
        {

            append rel mjc:target = </X30/Physics/HL_Knee_joint>
        }

        def MjcActuator "HR_HipX_joint_actuator"
        {
            uniform double mjc:forceRange:max = 84
            uniform double mjc:forceRange:min = -84
            custom rel mjc:target
            append rel mjc:target = </X30/Physics/HR_HipX_joint>
        }

        def MjcActuator "HR_HipY_joint_actuator"
        {
            uniform double mjc:forceRange:max = 84
            uniform double mjc:forceRange:min = -84
            custom rel mjc:target
            append rel mjc:target = </X30/Physics/HR_HipY_joint>
        }

        def MjcActuator "HR_Knee_joint_actuator"
        {
            uniform double mjc:forceRange:max = 150
            uniform double mjc:forceRange:min = -150

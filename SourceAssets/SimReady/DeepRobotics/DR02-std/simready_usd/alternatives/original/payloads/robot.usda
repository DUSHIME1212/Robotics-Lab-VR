                )
                {
                    over "left_shoulder_x_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "left_shoulder_z_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {

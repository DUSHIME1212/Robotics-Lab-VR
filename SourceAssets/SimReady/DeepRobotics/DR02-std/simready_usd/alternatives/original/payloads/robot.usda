                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "right_knee_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "right_ankle_y_link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "right_ankle_x_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "waist_z_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_shoulder_y_joint" (

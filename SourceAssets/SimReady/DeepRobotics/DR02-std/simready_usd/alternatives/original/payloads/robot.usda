#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "tn__DR02STD_sA"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "tn__DR02STD_sA" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </tn__DR02STD_sA/Physics/waist_z_joint>,
        </tn__DR02STD_sA/Physics/left_hip_y_joint>,
        </tn__DR02STD_sA/Physics/right_hip_y_joint>,
        </tn__DR02STD_sA/Physics/left_shoulder_y_joint>,
        </tn__DR02STD_sA/Physics/right_shoulder_y_joint>,
        </tn__DR02STD_sA/Physics/left_shoulder_x_joint>,
        </tn__DR02STD_sA/Physics/left_shoulder_z_joint>,
        </tn__DR02STD_sA/Physics/left_elbow_joint>,
        </tn__DR02STD_sA/Physics/right_shoulder_x_joint>,
        </tn__DR02STD_sA/Physics/right_shoulder_z_joint>,
        </tn__DR02STD_sA/Physics/right_elbow_joint>,
        </tn__DR02STD_sA/Physics/left_hip_x_joint>,
        </tn__DR02STD_sA/Physics/left_hip_z_joint>,
        </tn__DR02STD_sA/Physics/left_knee_joint>,
        </tn__DR02STD_sA/Physics/left_ankle_y_joint>,
        </tn__DR02STD_sA/Physics/left_ankle_x_joint>,
        </tn__DR02STD_sA/Physics/right_hip_x_joint>,
        </tn__DR02STD_sA/Physics/right_hip_z_joint>,
        </tn__DR02STD_sA/Physics/right_knee_joint>,
        </tn__DR02STD_sA/Physics/right_ankle_y_joint>,
        </tn__DR02STD_sA/Physics/right_ankle_x_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </tn__DR02STD_sA/Geometry/base_link>,
        </tn__DR02STD_sA/Geometry/base_link/body>,
        </tn__DR02STD_sA/Geometry/base_link/body/left_shoulder_y_link>,
        </tn__DR02STD_sA/Geometry/base_link/body/left_shoulder_y_link/left_shoulder_x_link>,
        </tn__DR02STD_sA/Geometry/base_link/body/left_shoulder_y_link/left_shoulder_x_link/left_shoulder_z_link>,
        </tn__DR02STD_sA/Geometry/base_link/body/left_shoulder_y_link/left_shoulder_x_link/left_shoulder_z_link/left_elbow_link>,
        </tn__DR02STD_sA/Geometry/base_link/body/right_shoulder_y_link>,
        </tn__DR02STD_sA/Geometry/base_link/body/right_shoulder_y_link/right_shoulder_x_link>,
        </tn__DR02STD_sA/Geometry/base_link/body/right_shoulder_y_link/right_shoulder_x_link/right_shoulder_z_link>,
        </tn__DR02STD_sA/Geometry/base_link/body/right_shoulder_y_link/right_shoulder_x_link/right_shoulder_z_link/right_elbow_link>,
        </tn__DR02STD_sA/Geometry/base_link/left_hip_y_link>,
        </tn__DR02STD_sA/Geometry/base_link/left_hip_y_link/left_hip_x_link>,
        </tn__DR02STD_sA/Geometry/base_link/left_hip_y_link/left_hip_x_link/left_hip_z_link>,
        </tn__DR02STD_sA/Geometry/base_link/left_hip_y_link/left_hip_x_link/left_hip_z_link/left_knee_link>,
        </tn__DR02STD_sA/Geometry/base_link/left_hip_y_link/left_hip_x_link/left_hip_z_link/left_knee_link/left_ankle_y_link>,
        </tn__DR02STD_sA/Geometry/base_link/left_hip_y_link/left_hip_x_link/left_hip_z_link/left_knee_link/left_ankle_y_link/left_ankle_x_link>,
        </tn__DR02STD_sA/Geometry/base_link/right_hip_y_link>,
        </tn__DR02STD_sA/Geometry/base_link/right_hip_y_link/right_hip_x_link>,
        </tn__DR02STD_sA/Geometry/base_link/right_hip_y_link/right_hip_x_link/right_hip_z_link>,
        </tn__DR02STD_sA/Geometry/base_link/right_hip_y_link/right_hip_x_link/right_hip_z_link/right_knee_link>,
        </tn__DR02STD_sA/Geometry/base_link/right_hip_y_link/right_hip_x_link/right_hip_z_link/right_knee_link/right_ankle_y_link>,
        </tn__DR02STD_sA/Geometry/base_link/right_hip_y_link/right_hip_x_link/right_hip_z_link/right_knee_link/right_ankle_y_link/right_ankle_x_link>,
    ]
    token isaac:robotType = "Humanoid"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "body" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "left_shoulder_y_link" (

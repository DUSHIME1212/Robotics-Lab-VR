#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "fr3_duo"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "fr3_duo" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </fr3_duo/Physics/mount_joint>,
        </fr3_duo/Physics/left_fr3v2_1_left_base_joint>,
        </fr3_duo/Physics/left_fr3v2_1_joint1>,
        </fr3_duo/Physics/left_fr3v2_1_joint2>,
        </fr3_duo/Physics/left_fr3v2_1_joint3>,
        </fr3_duo/Physics/left_fr3v2_1_joint4>,
        </fr3_duo/Physics/left_fr3v2_1_joint5>,
        </fr3_duo/Physics/left_fr3v2_1_joint6>,
        </fr3_duo/Physics/left_fr3v2_1_joint7>,
        </fr3_duo/Physics/right_fr3v2_1_right_base_joint>,
        </fr3_duo/Physics/right_fr3v2_1_joint1>,
        </fr3_duo/Physics/right_fr3v2_1_joint2>,
        </fr3_duo/Physics/right_fr3v2_1_joint3>,

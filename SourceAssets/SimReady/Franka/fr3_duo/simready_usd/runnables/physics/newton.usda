#usda 1.0
(
    defaultPrim = "fr3_duo"
    doc = "Newton overrides for fr3_duo.usda"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "fr3_duo"
{
    over "Geometry"

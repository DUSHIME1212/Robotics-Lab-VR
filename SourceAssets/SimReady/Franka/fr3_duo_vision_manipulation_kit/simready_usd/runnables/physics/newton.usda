                    ]
                }

                over "Joints"
                {
                    over "right_robotiq_left_inner_knuckle_joint" (
                        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
                        doc = "Passive joint, closed by Robotiq's loop-closure equality. The zero-gain drive only makes the joint explicit for NEWTON.DJ.001; it applies no force."
                    )
                    {
                        float drive:angular:physics:damping = 0
                        float drive:angular:physics:maxForce = 1
                        float drive:angular:physics:stiffness = 0
                    }

                    over "right_robotiq_right_inner_knuckle_joint" (
                        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
                        doc = "Passive joint, closed by Robotiq's loop-closure equality. The zero-gain drive only makes the joint explicit for NEWTON.DJ.001; it applies no force."
                    )
                    {
                        float drive:angular:physics:damping = 0
                        float drive:angular:physics:maxForce = 1
                        float drive:angular:physics:stiffness = 0
                    }

                    over "right_robotiq_left_inner_finger_joint" (
                        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
                    )
                    {
                        float drive:angular:physics:damping = 0
                        float drive:angular:physics:maxForce = 1
                        float drive:angular:physics:stiffness = 0
                    }

                    over "right_robotiq_right_inner_finger_joint" (

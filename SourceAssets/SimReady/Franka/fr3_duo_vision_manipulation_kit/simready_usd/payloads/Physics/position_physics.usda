#usda 1.0
(
    defaultPrim = "fr3_duo_vision_manipulation_kit"
    doc = """Position-control drive gains for fr3_duo_vision_manipulation_kit.usda, composed by ControlMode = \"position\".

Stiffness / damping in N*m/rad and N*m*s/rad:
joints 1-2: 4500 / 450, joints 3-4: 3500 / 350, joints 5-7: 2000 / 200.
These are the position-actuator gains (kp / kv) of the FR3 v2 model in MuJoCo Menagerie
(google-deepmind/mujoco_menagerie, franka_fr3_v2/fr3v2.xml), authored here per degree,
as UsdPhysics angular drives require.

Franka Hand finger joints (prismatic): 2000 N/m / 500 N*s/m. The stiffness is Isaac Lab's
Franka hand actuator (isaaclab_assets, robots/franka.py); the damping is raised from its 100
so the fingers stay under the URDF's 0.2 m/s. Both fingers are driven with the same target
in every solver (the URDF mimic is removed, see remove_mimic.py).
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "fr3_duo_vision_manipulation_kit"
{
    over "Physics"
    {
        over "left_fr3v2_1_joint1"
        {
            float drive:angular:physics:damping = 7.8539815
            float drive:angular:physics:stiffness = 78.53982
        }

        over "left_fr3v2_1_joint2"
        {
            float drive:angular:physics:damping = 7.8539815
            float drive:angular:physics:stiffness = 78.53982
        }

        over "left_fr3v2_1_joint3"
        {
            float drive:angular:physics:damping = 6.1086526
            float drive:angular:physics:stiffness = 61.086525
        }

        over "left_fr3v2_1_joint4"
        {
            float drive:angular:physics:damping = 6.1086526
            float drive:angular:physics:stiffness = 61.086525
        }

        over "left_fr3v2_1_joint5"
        {
            float drive:angular:physics:damping = 3.4906585
            float drive:angular:physics:stiffness = 34.906586
        }

        over "left_fr3v2_1_joint6"
        {
            float drive:angular:physics:damping = 3.4906585
            float drive:angular:physics:stiffness = 34.906586
        }

        over "left_fr3v2_1_joint7"
        {
            float drive:angular:physics:damping = 3.4906585
            float drive:angular:physics:stiffness = 34.906586
        }

        over "right_fr3v2_1_joint1"
        {
            float drive:angular:physics:damping = 7.8539815
            float drive:angular:physics:stiffness = 78.53982
        }

        over "right_fr3v2_1_joint2"
        {
            float drive:angular:physics:damping = 7.8539815
            float drive:angular:physics:stiffness = 78.53982
        }

        over "right_fr3v2_1_joint3"
        {
            float drive:angular:physics:damping = 6.1086526
            float drive:angular:physics:stiffness = 61.086525
        }

        over "right_fr3v2_1_joint4"
        {
            float drive:angular:physics:damping = 6.1086526
            float drive:angular:physics:stiffness = 61.086525
        }

        over "right_fr3v2_1_joint5"
        {
            float drive:angular:physics:damping = 3.4906585
            float drive:angular:physics:stiffness = 34.906586
        }

        over "right_fr3v2_1_joint6"
        {
            float drive:angular:physics:damping = 3.4906585
            float drive:angular:physics:stiffness = 34.906586
        }

        over "right_fr3v2_1_joint7"
        {
            float drive:angular:physics:damping = 3.4906585
            float drive:angular:physics:stiffness = 34.906586
        }
    }
}


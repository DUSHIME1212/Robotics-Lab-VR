                                                                                                        float fStop = 0
                                                                                                        float horizontalAperture = 4.8
                                                                                                        float verticalAperture = 2.71698
                                                                                                        float omni:sensor:tickRate = 24
                                                                                                        quatd xformOp:orient = (-1.4332476316880616e-9, 1, -2.487917427629327e-9, -6.017332854213464e-9)
                                                                                                        double3 xformOp:scale = (1, 1, 1)
                                                                                                        double3 xformOp:translate = (-1.4901161193847656e-8, 0, 0)
                                                                                                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

#usda 1.0
(
    defaultPrim = "fr3_duo_vision_manipulation_kit"
    doc = """Sensors of fr3_duo_vision_manipulation_kit.usda: cameras, lidars and IMU as native Isaac Sim sensor prims,
with one render product each. Poses and camera intrinsics come from Franka's sensor
profile 'franka_vision_and_manipulation_kit' (synthetic_simulation calibration).
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "fr3_duo_vision_manipulation_kit"
{
    over "Geometry"
    {
        over "base"
        {
            over "fr3_duo_mount_mounting_point"

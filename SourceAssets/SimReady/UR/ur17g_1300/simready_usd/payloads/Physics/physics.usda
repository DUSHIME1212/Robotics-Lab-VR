            custom rel physics:body1
            append rel physics:body1 = </ur17g_1300/Geometry/world/base_link/base_link_inertia/shoulder_link/upper_arm_link/forearm_link/wrist_1_link/wrist_2_link>
            point3f physics:localPos0 = (2.220446e-16, -0.1361, -2.7914587e-11)

#usda 1.0
(
    "Universal Robots UR17g-1300. Kinematic, joint-limit, inertial and structural data derived from Universal Robots' Universal_Robots_ROS2_Description (ur_description), licensed under the BSD 3-Clause License. See LICENSE-BSD-3-Clause.txt."
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
        string license = "BSD-3-Clause"
        string license_files = "LICENSE-BSD-3-Clause.txt"
        string license_notice = "Kinematic, joint-limit, inertial and structural data derived from Universal Robots' Universal_Robots_ROS2_Description (ur_description), licensed under the BSD 3-Clause License. See LICENSE-BSD-3-Clause.txt."
    }
    defaultPrim = "ur17g_1300"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "ur17g_1300"
{
    over "Geometry"
    {
        over "world"
        {
            over "base_link"
            {
                over "base_link_inertia" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    point3f physics:centerOfMass = (0, 0, 0)
                    float3 physics:diagonalInertia = (0.03223332, 0.03223332, 0.0578)
                    float physics:mass = 4
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "shoulder_link" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                        point3f physics:centerOfMass = (0.000024, -0.025304, -0.033309)
                        float3 physics:diagonalInertia = (0.029906383, 0.051333707, 0.05205891)
                        float physics:mass = 9.9883
                        quatf physics:principalAxes = (-0.6906003, -0.15383291, -0.16818321, 0.6863826)

                        over "upper_arm_link" (
                            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                        )
                        {
                            point3f physics:centerOfMass = (-0.228491, -0.000083, 0.192787)
                            float3 physics:diagonalInertia = (0.047292504, 1.1836803, 1.1884992)
                            float physics:mass = 14.9255
                            quatf physics:principalAxes = (0.70876104, 0.70530677, -0.010098789, 0.00990651)

                            over "forearm_link" (
                                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                            )
                            {
                                point3f physics:centerOfMass = (-0.210929, 0.000019, 0.070552)
                                float3 physics:diagonalInertia = (0.017818023, 0.29750597, 0.303502)
                                float physics:mass = 6.1015
                                quatf physics:principalAxes = (0.70673466, 0.7070595, 0.017220944, -0.017216131)

                                over "wrist_1_link" (
                                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                                )
                                {
                                    point3f physics:centerOfMass = (0.000025, -0.016413, -0.019695)
                                    float3 physics:diagonalInertia = (0.0022482492, 0.0042110677, 0.0043396833)
                                    float physics:mass = 2.089
                                    quatf physics:principalAxes = (0.16272259, 0.6851511, 0.11880961, 0.6999811)

                                    over "wrist_2_link" (
                                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                                    )
                                    {
                                        point3f physics:centerOfMass = (0.000025, 0.015886, -0.01996)
                                        float3 physics:diagonalInertia = (0.0022586037, 0.0042326786, 0.004289718)
                                        float physics:mass = 2.0869
                                        quatf physics:principalAxes = (0.6757226, 0.19960344, 0.7046708, 0.083645105)

                                        over "wrist_3_link" (
                                            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                                        )
                                        {
                                            point3f physics:centerOfMass = (-0.000018, -0.000112, -0.053397)
                                            float3 physics:diagonalInertia = (0.0010003353, 0.0014022221, 0.0014094426)
                                            float physics:mass = 1.0666
                                            quatf physics:principalAxes = (-0.64493215, 0.26829278, 0.6758145, 0.2352791)

                                            over "smart_panel" (
                                                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                                            )
                                            {
                                                point3f physics:centerOfMass = (0, 0, 0)
                                                float3 physics:diagonalInertia = (0.0001, 0.0001, 0.0001)
                                                float physics:mass = 0.1
                                                quatf physics:principalAxes = (1, 0, 0, 0)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        def PhysicsRevoluteJoint "shoulder_pan_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 7.85514
            float drive:angular:physics:maxForce = 433
            float drive:angular:physics:stiffness = 1963.7845
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </ur17g_1300/Geometry/world/base_link/base_link_inertia>
            custom rel physics:body1
            append rel physics:body1 = </ur17g_1300/Geometry/world/base_link/base_link_inertia/shoulder_link>
            point3f physics:localPos0 = (0, 0, 0.2186)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -360
            float physics:upperLimit = 360
            custom float urdf:limit:effort = 433
        }


#usda 1.0
(
    defaultPrim = "n_220_27"
    metersPerUnit = 1
    subLayers = [
        @./geometries.usd@
    ]
    upAxis = "Z"
)

def Scope "visuals"
{
    token visibility = "invisible"

    def Xform "base_link"
    {
        def Xform "base_link" (
            references = </meshes/base_link>
        )
        {
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }

    def Xform "link_1"
    {
        def Xform "Link1" (
            references = </meshes/Link1>

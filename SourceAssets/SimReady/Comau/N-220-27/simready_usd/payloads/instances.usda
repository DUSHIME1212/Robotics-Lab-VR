over "meshes"
{
    over "base_link"
    {
        over "mesh" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </n_220_27/Looks/Finish_Comau_Red__SatinPaint>

            over "Rear_Connector_Hardware" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </n_220_27/Looks/S18_Connector_SatinMetal>
            }
        }
    }

    over "Link1"

    over "Physics"
    {
        def PhysicsRevoluteJoint "joint_1" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float newton:velocityLimit = 205.01003
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </S18_17/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </S18_17/Geometry/base_link/link_1>

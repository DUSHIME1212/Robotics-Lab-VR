#usda 1.0
(
    defaultPrim = "spark"
)

over "spark"
{
    over "Looks"
    {
        over "material_base_link_color"
        {
            token outputs:surface.connect = </spark/Looks/material_base_link_color/PreviewSurface.outputs:surface>

            over "Shader"
            {
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.32
            }

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86667, 0.86667, 0.8902)
                float inputs:metallic = 0
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        over "material_forearm_link_color"
        {
            token outputs:surface.connect = </spark/Looks/material_forearm_link_color/PreviewSurface.outputs:surface>

            over "Shader"
            {

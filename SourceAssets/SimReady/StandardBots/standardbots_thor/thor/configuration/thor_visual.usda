#usda 1.0
(
    """Visual-appearance layer for thor, built by tools/texture_nvidia_asset.py on 2026-09-29.
Replaces the STL visual meshes NVIDIA's URDF import made with the textured meshes the
web visualizer renders (../meshes/visual/<link>.usd, converted from its GLBs), each
rotated into its link frame by the measured rotation, and sets metallic_factor to the
visualizer's runtime value (0.5; the GLBs leave it unset = glTF 1.0).
Geometry, collision and physics layers are untouched; removing this layer from
thor_physics.usd's subLayers restores NVIDIA's plain STL look."""
    defaultPrim = "thor"
    subLayers = [
        @./thor_base.usd@
    ]
)

over "visuals"
{
    over "base_link"
    {
        over "base_link" (
            active = false
        )
        {
        }

        def Xform "base_link_textured" (
            "from base_link.glb (sha256 5e60a221dfc8)"
            prepend references = @../meshes/visual/base_link.usd@
        )
        {
            quatd xformOp:orient = (0.7071067811865475, 0.7071067811865476, 0, 0)
            double3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "Looks"
            {
                over "New_Arm_Hard_Anodise_Black__1_004"
                {
                    token outputs:surface.connect = </visuals/base_link/base_link_textured/Looks/New_Arm_Hard_Anodise_Black__1_004/PreviewSurface.outputs:surface>

                    over "New_Arm_Hard_Anodise_Black__1_004"
                    {
                        float inputs:metallic_factor = 0.5
                    }

                    def Shader "PreviewSurface"
                    {
                        uniform token info:id = "UsdPreviewSurface"
                        color3f inputs:diffuseColor = (0.0117647, 0.0117647, 0.0117647)
                        float inputs:ior = 1.45
                        float inputs:metallic = 0.5
                        float inputs:roughness = 0.5527864
                        token outputs:surface
                    }
                }

                over "Aluminum_Rough___1__1_002"
                {
                    token outputs:surface.connect = </visuals/base_link/base_link_textured/Looks/Aluminum_Rough___1__1_002/PreviewSurface.outputs:surface>

                    over "Aluminum_Rough___1__1_002"
                    {
                        float inputs:metallic_factor = 0.5
                    }

                    def Shader "PreviewSurface"
                    {
                        uniform token info:id = "UsdPreviewSurface"
                        color3f inputs:diffuseColor = (0.792157, 0.819608, 0.933333)
                        float inputs:ior = 1.45
                        float inputs:metallic = 0.5
                        float inputs:roughness = 0.5527864
                        token outputs:surface
                    }
                }

                over "Hard_Rough_Plastic_Grey__1_002"
                {
                    token outputs:surface.connect = </visuals/base_link/base_link_textured/Looks/Hard_Rough_Plastic_Grey__1_002/PreviewSurface.outputs:surface>


#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "black_02_ncl1_1"
    {
        color3f inputs:diffuseColor = (0, 0, 0)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.45
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/black_02_ncl1_1/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/black_02_ncl1_1/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/black_02_ncl1_1.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/black_02_ncl1_1.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/black_02_ncl1_1.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/black_02_ncl1_1.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }

    def Material "white_ncl1_1"
    {
        color3f inputs:diffuseColor = (0.5477945, 0.5477945, 0.5477945)
        float inputs:metallic = 0.66
        float inputs:opacity = 1
        float inputs:roughness = 0.62
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/white_ncl1_1/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/white_ncl1_1/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/white_ncl1_1.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/white_ncl1_1.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/white_ncl1_1.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/white_ncl1_1.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }

    def Material "orange_ncl1_1"
    {
        color3f inputs:diffuseColor = (0.95510465, 0.15487249, 0)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/orange_ncl1_1/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/orange_ncl1_1/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/orange_ncl1_1.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/orange_ncl1_1.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/orange_ncl1_1.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/orange_ncl1_1.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }
}


--- !u!114 &208342392
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 208342390}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d7f0e6770f9b60c4d9f7bf206eafd170, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RoboticsLab.LessonStation
  chapter: 4
  lessonTitle: The Art of Holding
  verificationName: Handling
  concept: 'The end effector is the robot''s ''hand''. The 2F-85 is an adaptive two-finger gripper: one motor drives a linkage that keeps the pads parallel over an 85 mm stroke. (The linkage is approximated in this simulation.)'
  echoIntro: An arm can reach a thousand places. But without the right tool, it can't do much when it gets there.
  echoComplete: 'Reach plus the right tool: that''s how robots actually change the world around them.'
  robot: {fileID: 0}
  pendant: {fileID: 316442068}
  gripper: {fileID: 1843243221}
  gait: {fileID: 0}
  safety: {fileID: 0}
  steps:
  - instruction: Press Close, then Open, and watch the parallel linkage.
    hint: The Open and Close buttons are on the gripper panel.
    check: 6
    jointIndex: 0
    value: 4
    tolerance: 5
    target: {fileID: 0}
    zone: {fileID: 0}
    item: {fileID: 0}
  - instruction: Grab the gripper, pick up the blue component and release it in the green zone.
    hint: Hold the gripper above the blue cube with the fingers around it, press Close, carry it over the green box, then press Open.
    check: 4
    jointIndex: 0
    value: 0
    tolerance: 5
    target: {fileID: 0}
    zone: {fileID: 958336952}
    item: {fileID: 1410075365}
  board: {fileID: 233264147}
  spotlight: {fileID: 639654016}
  hintAfterSeconds: 45
  specs: "Robotiq 2F-85:  Payload 5 kg  \xB7  Stroke 85 mm  \xB7  Grip 20-235 N  \xB7  1 DOF  \xB7  0.9 kg"

--- !u!114 &15411517
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 15411515}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d7f0e6770f9b60c4d9f7bf206eafd170, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RoboticsLab.LessonStation
  chapter: 1
  lessonTitle: The Language of Motion
  verificationName: Motion
  concept: 'A serial arm is a chain of links joined by joints. Each joint adds one degree of freedom (DOF). The UR17 has 6. Joint angles determine where the tool is: that is FORWARD KINEMATICS.'
  echoIntro: 'Ready for your first challenge? Let''s start with the simplest question in robotics: how does a robot know where its hand is? Your arm has joints. This one does too. The difference is that this robot needs numbers to describe every movement.'
  echoComplete: Every position of that tool came from six numbers. Now you speak the language of motion.
  robot: {fileID: 513262233}
  pendant: {fileID: 2080184739}
  gripper: {fileID: 0}
  gait: {fileID: 0}
  safety: {fileID: 0}
  steps:
  - instruction: "Rotate the base: set J1 to +90\xB0. Watch the whole arm swing: J1 moves everything after it."
    hint: "Point at the J1 slider, hold the trigger and drag right until the readout shows about 90\xB0."
    check: 1
    jointIndex: 0
    value: 90
    tolerance: 6
    target: {fileID: 0}
    zone: {fileID: 0}
    item: {fileID: 0}
  - instruction: "Raise the shoulder: set J2 to -60\xB0."
    hint: J2 is the second slider. Drag it left of centre.
    check: 1
    jointIndex: 1
    value: -60
    tolerance: 8
    target: {fileID: 0}
    zone: {fileID: 0}
    item: {fileID: 0}
  - instruction: "Bend the elbow: set J3 to +90\xB0 and watch the tool position readout change."
    hint: J3 is the elbow. The X/Y/Z readout is forward kinematics, computed from your joint angles.
    check: 1
    jointIndex: 2
    value: 90
    tolerance: 8
    target: {fileID: 0}
    zone: {fileID: 0}
    item: {fileID: 0}
  - instruction: 'Requested tool pose: move the tool into the green sphere using only the joint sliders.'
    hint: "Try J1 near 45\xB0, then adjust J2 and J3 together. The base sets the direction, shoulder and elbow set the reach."
    check: 2
    jointIndex: 0
    value: 0
    tolerance: 0.07
    target: {fileID: 1166609960}
    zone: {fileID: 0}
    item: {fileID: 0}
  board: {fileID: 1176439469}
  spotlight: {fileID: 477503049}
  hintAfterSeconds: 45
  specs: "Universal Robots UR17g-1300:  Payload 17.5 kg  \xB7  Reach 1300 mm  \xB7  Repeatability \xB10.05 mm  \xB7  TCP 5 m/s  \xB7  6 DOF  \xB7  40.7 kg"

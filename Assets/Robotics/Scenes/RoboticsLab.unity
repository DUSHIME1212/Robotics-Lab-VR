  m_Script: {fileID: 11500000, guid: d7f0e6770f9b60c4d9f7bf206eafd170, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RoboticsLab.LessonStation
  chapter: 5
  lessonTitle: The Boundary
  verificationName: Safety
  concept: Heavy industrial robots work inside FENCED CELLS with interlocks, light curtains and emergency stops. Program from OUTSIDE. Crossing the light curtain triggers a simulated E-stop. (Robot shown at 50% scale.)
  echoIntro: 'You''ve learned how to make machines move. Now comes one of the most important things an engineer can learn: when a machine must not move.'
  echoComplete: You programmed a 220 kg robot without ever stepping inside its cell.
  robot: {fileID: 1591010878}
  pendant: {fileID: 1985928527}
  gripper: {fileID: 0}
  gait: {fileID: 0}
  safety: {fileID: 2127544907}
  steps:
  - instruction: From OUTSIDE the yellow fence, teach two waypoints and press Run.
    hint: Stay on the teleport pad. Everything you need is on the cell controller panel.
    check: 3
    jointIndex: 0
    value: 2
    tolerance: 5
    target: {fileID: 0}
    zone: {fileID: 0}
    item: {fileID: 0}
  - instruction: "Joint limits stop self-collision. Note J3's uneven limits, then rotate J1 to -90\xB0."
    hint: "J1 is the first slider. Drag it left to -90\xB0."
    check: 1
    jointIndex: 0
    value: -90
    tolerance: 8
    target: {fileID: 0}
    zone: {fileID: 0}
    item: {fileID: 0}
  board: {fileID: 314439649}
  spotlight: {fileID: 1959014671}
  hintAfterSeconds: 45
  specs: "Comau N-220-2.7:  Payload 220 kg  \xB7  Reach 2670 mm  \xB7  Repeatability \xB10.05 mm  \xB7  IP65  \xB7  6 DOF  \xB7  1193 kg"

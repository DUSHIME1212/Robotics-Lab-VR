MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 157858869}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d7f0e6770f9b60c4d9f7bf206eafd170, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RoboticsLab.LessonStation
  chapter: 3
  lessonTitle: Teach the Machine
  verificationName: Programming
  concept: 'Industrial robots are programmed by TEACHING: jog to a pose, record it as a waypoint, repeat, then run. MoveJ moves every joint at once to the next recorded pose.'
  echoIntro: A robot doesn't understand what you want. It follows what you program. So let's give it instructions it can repeat.
  echoComplete: That sequence will now run exactly the same way a thousand times. That's what programming a robot means.
  robot: {fileID: 654192668}
  pendant: {fileID: 504045361}
  gripper: {fileID: 0}
  gait: {fileID: 0}
  safety: {fileID: 0}
  steps:
  - instruction: Jog the arm to a 'pick' pose and press Record (P1).
    hint: Move a few sliders, then press Record.
    check: 6
    jointIndex: 0
    value: 3
    tolerance: 5
    target: {fileID: 0}
    zone: {fileID: 0}
    item: {fileID: 0}
  - instruction: Record an 'approach' pose and a 'place' pose (P2, P3), then press Run.
    hint: You need three recorded waypoints before Run. The readout shows how many you have.
    check: 3
    jointIndex: 0
    value: 3
    tolerance: 5
    target: {fileID: 0}
    zone: {fileID: 0}
    item: {fileID: 0}
  - instruction: Press Home. Programs should start and end in a known, safe pose.
    hint: "Home sets every joint back to 0\xB0."
    check: 1
    jointIndex: 1
    value: 0
    tolerance: 2
    target: {fileID: 0}
    zone: {fileID: 0}
    item: {fileID: 0}
  board: {fileID: 682383151}
  spotlight: {fileID: 234865860}
  hintAfterSeconds: 45
  specs: "FANUC CRX-10iA:  Payload 10 kg  \xB7  Reach 1249 mm  \xB7  Repeatability \xB10.04 mm  \xB7  6 DOF  \xB7  40 kg"

--- !u!114 &1978669578
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1978669576}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d7f0e6770f9b60c4d9f7bf206eafd170, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RoboticsLab.LessonStation
  chapter: 6
  lessonTitle: Learning to Walk
  verificationName: Locomotion
  concept: 'Each Lite3 leg has 3 joints: 12 DOF in all. In a TROT, diagonal leg pairs swing together so two feet always support the body. Frequency and stride set the rhythm. (This walks in place: it shows gait coordination, not balance or terrain.)'
  echoIntro: We've spent all day teaching arms how to move. But what if the robot itself needs to move through the world?
  echoComplete: Twelve joints, one rhythm. Coordination is what turns joints into walking.
  robot: {fileID: 777911604}
  pendant: {fileID: 1443975376}
  gripper: {fileID: 0}
  gait: {fileID: 777911603}
  safety: {fileID: 0}
  steps:
  - instruction: Press Trot and watch front-left + hind-right swing together.
    hint: Trot is the middle button on the gait panel.
    check: 5
    jointIndex: 0
    value: 1
    tolerance: 5
    target: {fileID: 0}
    zone: {fileID: 0}
    item: {fileID: 0}
  - instruction: While trotting, set the gait frequency to about 1.0 Hz.
    hint: Drag the frequency slider left. Slower steps are easier to watch.
    check: 7
    jointIndex: 0
    value: 1
    tolerance: 0.15
    target: {fileID: 0}
    zone: {fileID: 0}
    item: {fileID: 0}
  - instruction: Press Sit to end the demonstration.
    hint: Sit is the right-hand gait button.
    check: 5
    jointIndex: 0
    value: 2
    tolerance: 5
    target: {fileID: 0}
    zone: {fileID: 0}
    item: {fileID: 0}
  board: {fileID: 751016777}
  spotlight: {fileID: 1715003626}
  hintAfterSeconds: 45
  specs: "DEEP Robotics Lite3:  Payload 5 kg  \xB7  Speed 2.5 m/s  \xB7  12 DOF  \xB7  12.2 kg"

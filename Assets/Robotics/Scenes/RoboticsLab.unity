--- !u!114 &724686583
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 724686581}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d7f0e6770f9b60c4d9f7bf206eafd170, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RoboticsLab.LessonStation
  chapter: 2
  lessonTitle: One Target, Many Solutions
  verificationName: Precision
  concept: 'Inverse kinematics (IK) works backwards: choose where the tool must go, and the solver finds the joint angles. With 7 joints the FR3 is REDUNDANT: many elbow poses reach the same point.'
  echoIntro: Before, you chose the joint angles and observed the result. Now you choose the result, and the robot must work out the angles.
  echoComplete: You gave the robot a destination, not instructions, and it found its own way there.
  robot: {fileID: 1728800021}
  pendant: {fileID: 1421970934}
  gripper: {fileID: 0}
  gait: {fileID: 0}
  safety: {fileID: 0}
  steps:
  - instruction: 'Press ''IK: drag target'' on the pendant to switch the solver on.'
    hint: The IK button is on the panel to the right of the robot.
    check: 6
    jointIndex: 0
    value: 3
    tolerance: 5
    target: {fileID: 0}
    zone: {fileID: 0}
    item: {fileID: 0}
  - instruction: Grab the orange handle and guide the tool into the green sphere.
    hint: Point at the orange ball, squeeze the grip button and move your hand. The arm follows.
    check: 2
    jointIndex: 0
    value: 0
    tolerance: 0.06
    target: {fileID: 1005356467}
    zone: {fileID: 0}
    item: {fileID: 0}
  - instruction: 'Drag the handle far behind the robot and watch the IK error grow: some targets have NO solution.'
    hint: Reach is limited. The workspace is roughly a sphere about 0.9 m around the shoulder.
    check: 6
    jointIndex: 0
    value: 10
    tolerance: 5
    target: {fileID: 0}
    zone: {fileID: 0}
    item: {fileID: 0}
  board: {fileID: 2059575312}
  spotlight: {fileID: 1570118324}
  hintAfterSeconds: 45
  specs: "Franka Research 3:  Payload 3 kg  \xB7  Reach 855 mm  \xB7  Repeatability \xB10.1 mm  \xB7  7 DOF  \xB7  17.8 kg"
